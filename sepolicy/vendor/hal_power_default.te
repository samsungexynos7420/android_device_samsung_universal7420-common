# hal_power_default.te

allow hal_power_default{
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_sec_tsp
    sysfs_power_writable
    sysfs_touchscreen_writable
}:dir r_dir_perms;

allow hal_power_default{
    pm_qos_device
    sysfs_backlight_writable
    sysfs_batteryinfo
    sysfs_devices_system_cpu
    sysfs_graphics
    sysfs_light
    sysfs_sec_tsp
    sysfs_input
    sysfs_touchscreen_writable
}:file rw_file_perms;

allow hal_power_default sysfs_sec_tsp:lnk_file read;
allow hal_power_default property_socket:sock_file write;
allow hal_power_default init:unix_stream_socket { connectto };
allow hal_power_default device:file rw_file_perms;
set_prop(hal_power_default, vendor_default_prop)
get_prop(hal_power_default, vendor_default_prop)